{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "shiroi-hackers",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	// 初回デプロイで D1 と R2 が自動で作られ、database_id がここに書き足されます
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "shiroi-hackers",
		},
	],
	// 前回のデプロイで先に作られたセッション用KVを使い回す
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "9e72632bc2a34c56af9dc8093d6f49c9",
		},
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "shiroi-hackers-media",
		},
	],
	// Sandboxed plugins require Worker Loader, available on Workers paid plans. Uncomment to enable:
	// "worker_loaders": [{ "binding": "LOADER" }],
	// General maintenance cron trigger
	"triggers": {
		"crons": ["* * * * *"],
	},
}
